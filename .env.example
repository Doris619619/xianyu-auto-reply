# DeepSeek API 密钥（必填，才能生成议价草稿）
DEEPSEEK_API_KEY=

# tracknick Cookie 的 SHA-256（64 位小写十六进制），登录标定后填写
XIANYU_EXPECTED_ACCOUNT_ID=

# Playwright 登录态文件路径（由 scripts/login_xianyu.py 生成，勿提交）
XIANYU_STORAGE_STATE_PATH=storage_state.json

# 默认有头；无头更容易触发闲鱼风控
XIANYU_HEADLESS=false

# SQLite 数据库
DATABASE_URL=sqlite:///./data/bargain.db

# 控制面板监听
APP_HOST=127.0.0.1
APP_PORT=8787

# 议价默认参数（也可在面板修改，写入 settings 表）
DEFAULT_REPLY_TIMEOUT_SECONDS=180
DEFAULT_MAX_ROUNDS=6
DEFAULT_AUTO_SEND=true

LOG_LEVEL=INFO
