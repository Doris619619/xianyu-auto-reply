# DeepSeek API 密钥（必填，才能生成议价草稿）
DEEPSEEK_API_KEY=

# tracknick Cookie 的 SHA-256（64 位小写十六进制），登录标定后填写
XIANYU_EXPECTED_ACCOUNT_ID=

# AI Worker 浏览器实现：chromium | camoufox | cloakbrowser
# camoufox / cloakbrowser 需额外安装：pip install -e ".[camoufox]" 或 ".[cloakbrowser]"
XIANYU_BROWSER_BACKEND=chromium

# 可选：覆盖登录态路径。不配则按后端使用 data/browser_states/{backend}_storage_state.json
# chromium 在新路径不存在时会兼容回退根目录 storage_state.json
# XIANYU_STORAGE_STATE_PATH=data/browser_states/cloakbrowser_storage_state.json

# 默认有头；无头更容易触发闲鱼风控
XIANYU_HEADLESS=false

# 仅手动回复模式：连接本机已打开的可见浏览器调试端口（不用于 AI Worker）
# XIANYU_CDP_ENDPOINT=http://127.0.0.1:9222

# SQLite 数据库
DATABASE_URL=sqlite:///./data/bargain.db

# 控制面板监听
APP_HOST=127.0.0.1
APP_PORT=8787

# 议价默认参数（也可在面板修改，写入 settings 表）
DEFAULT_REPLY_TIMEOUT_SECONDS=180
DEFAULT_MAX_ROUNDS=6
DEFAULT_AUTO_SEND=true

LOG_LEVEL=INFO
